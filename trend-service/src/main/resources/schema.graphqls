type TrendQuery {
  id: ID!
  seedKeyword: String!
  query: String!
  createdAt: DateTime!
  scores(limit: Int = 10, offset: Int = 0): [TrendScore!]!
}

type TrendScore {
  id: ID!
  score: Int!
  delta: Int!
  region: String!
  source: String
  fetchedAt: DateTime!
}

type TrendSummary {
  query: String!
  seedKeyword: String
  latestScore: Int!
  velocity: Int!
  source: String
  normalizedScore: Int
  topRegions(limit: Int = 5): [RegionScore!]!
  designBriefs: [DesignBriefSummary!]!
}

type RegionScore {
  region: String!
  score: Int!
}

type TrendUpdate {
  query: String!
  delta: Int!
  score: Int!
  timestamp: DateTime!
}

type TrendQueryConnection {
  edges: [TrendQueryEdge!]!
  pageInfo: PageInfo!
}

type TrendQueryEdge {
  node: TrendQuery!
  cursor: String!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  totalCount: Int!
}

type ActiveSeedSummary {
  id: ID!
  query: String!
  promotionScore: Int!
  productTags: [String!]!
}

type DesignBriefSummary {
  id: ID!
  concept: String!
  productType: String!
  specificProducts: [String!]!
  audience: String
  visualStyle: String
  confidence: Int!
  reasoning: String
  llmModel: String
  batchId: String
  createdAt: DateTime
  sourceSeeds: [String!]!
  imageKeyRaw: String
  imageKeyTransparent: String
  imageUrl: String
  imageTransparentUrl: String
  listingDescription: String
  voice: String
  stylePreset: String
  fontFamily: String
  recommendedMaterials: [MaterialRecommendation!]!
  pricing: BriefPricing
  imageStatus: String
  imageError: String
}

type MaterialRecommendation {
  external_id: String
  name: String
  color: String
  substrate_type: String
  unit_cost: Float
}

type BriefPricing {
  requested_positioning: String
  effective_positioning: String
  positioning_reason: String
  confidence: Int
  target_margin: Float
  status: String
  currency: String
  policy_version: Int
  print_rate_per_sq_in: Float
  quotes: [MaterialQuote!]!
}

type MaterialQuote {
  external_id: String
  requested_positioning: String
  positioning: String
  status: String
  recommended_price: Float
  currency: String
  size_prices: [SizePrice!]!
  print_size: PrintSize
  price_breakdown: PriceBreakdown
}

type SizePrice {
  size: String
  price: Float
}

type PrintSize {
  width_in: Float
  height_in: Float
  placement: String
  target_dpi: Int
  required_pixels: PixelSize
  source_pixels: PixelSize
  upscale_factor: Float
  estimated: Boolean
}

type PixelSize {
  width: Int
  height: Int
}

type PriceBreakdown {
  material_cost: Float
  print_cost: Float
  print_rate_per_sq_in: Float
  marketplace_fee: Float
  target_margin: Float
  actual_margin: Float
}

type Query {
  trendQueries(limit: Int = 100, offset: Int = 0): TrendQueryConnection!
  trendSummary(query: String!): TrendSummary
  topTrends(limit: Int = 10, hasDesignBriefs: Boolean = false): [TrendSummary!]!
  trendHistory(query: String!, days: Int = 30): [TrendScore!]!
  activeSeeds(tag: String, limit: Int = 50): [ActiveSeedSummary!]!
  productTags: [String!]!
  designBriefs(productType: String, batchId: String, limit: Int = 20): [DesignBriefSummary!]!
}

type Subscription {
  trendUpdated: TrendUpdate!
}
