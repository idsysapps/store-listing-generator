type TrendQuery {
  id: ID!
  seedKeyword: String!
  query: String!
  createdAt: DateTime!
  scores(limit: Int = 10, offset: Int = 0): [TrendScore!]!
}

type TrendScore {
  id: ID!
  score: Int!
  delta: Int!
  region: String!
  source: String
  fetchedAt: DateTime!
}

type TrendSummary {
  query: String!
  seedKeyword: String
  latestScore: Int!
  velocity: Int!
  source: String
  topRegions(limit: Int = 5): [RegionScore!]!
  designBriefs: [DesignBriefSummary!]!
}

type RegionScore {
  region: String!
  score: Int!
}

type TrendUpdate {
  query: String!
  delta: Int!
  score: Int!
  timestamp: DateTime!
}

type TrendQueryConnection {
  edges: [TrendQueryEdge!]!
  pageInfo: PageInfo!
}

type TrendQueryEdge {
  node: TrendQuery!
  cursor: String!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  totalCount: Int!
}

type ActiveSeedSummary {
  id: ID!
  query: String!
  promotionScore: Int!
  productTags: [String!]!
}

type DesignBriefSummary {
  id: ID!
  concept: String!
  productType: String!
  specificProducts: [String!]!
  audience: String
  visualStyle: String
  confidence: Int!
  reasoning: String
  llmModel: String
  batchId: String
  createdAt: DateTime
  sourceSeeds: [String!]!
}

type Query {
  trendQueries(limit: Int = 100, offset: Int = 0): TrendQueryConnection!
  trendSummary(query: String!): TrendSummary
  topTrends(limit: Int = 10): [TrendSummary!]!
  trendHistory(query: String!, days: Int = 30): [TrendScore!]!
  activeSeeds(tag: String, limit: Int = 50): [ActiveSeedSummary!]!
  productTags: [String!]!
  designBriefs(productType: String, batchId: String, limit: Int = 20): [DesignBriefSummary!]!
}

type Subscription {
  trendUpdated: TrendUpdate!
}
