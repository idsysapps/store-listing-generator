type TrendQuery {
  id: ID!
  seedKeyword: String!
  query: String!
  createdAt: DateTime!
  scores(limit: Int = 10, offset: Int = 0): [TrendScore!]!
}

type TrendScore {
  id: ID!
  score: Int!
  delta: Int!
  region: String!
  fetchedAt: DateTime!
}

type TrendSummary {
  query: String!
  latestScore: Int!
  velocity: Int!
  topRegions(limit: Int = 5): [RegionScore!]!
}

type RegionScore {
  region: String!
  score: Int!
}

type TrendUpdate {
  query: String!
  delta: Int!
  score: Int!
  timestamp: DateTime!
}

type TrendQueryConnection {
  edges: [TrendQueryEdge!]!
  pageInfo: PageInfo!
}

type TrendQueryEdge {
  node: TrendQuery!
  cursor: String!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  totalCount: Int!
}

type Query {
  trendQueries(limit: Int = 100, offset: Int = 0): TrendQueryConnection!
  trendSummary(query: String!): TrendSummary
  topTrends(limit: Int = 10): [TrendSummary!]!
  trendHistory(query: String!, days: Int = 30): [TrendScore!]!
}

type Subscription {
  trendUpdated: TrendUpdate!
}
